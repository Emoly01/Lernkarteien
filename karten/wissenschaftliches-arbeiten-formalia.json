  {
   "id": "waf5-v2-06",
   "subject": "Wissenschaftliches Arbeiten – Formalia",
   "title": "WA5 · Wie erstellt man Verzeichnisse automatisch?",
   "status": "neu",
   "lines": [
    {
     "id": "waf5-v2-06-01",
     "level": 0,
     "text": "Inhaltsverzeichnis: Überschriften laufend definieren → Seitenumbruch vor der Einleitung → Inhaltsverzeichnis erstellen → laufend aktualisieren"
    },
    {
     "id": "waf5-v2-06-02",
     "level": 0,
     "text": "Tabellen-, Abbildungs- und Abkürzungsverzeichnis: nach dem Inhaltsverzeichnis, ebenfalls automatisch"
    }
   ]
  },
  {
   "id": "waf5-v2-07",
   "subject": "Wissenschaftliches Arbeiten – Formalia",
   "title": "WA5 · Wie sichert man seine Daten?",
   "status": "neu",
   "lines": [
    {
     "id": "waf5-v2-07-01",
     "level": 0,
     "text": "Häufig speichern"
    },
    {
     "id": "waf5-v2-07-02",
     "level": 0,
     "text": "Regelmäßig Sicherungskopien machen"
    },
    {
     "id": "waf5-v2-07-03",
     "level": 0,
     "text": "Mindestens zwei verschiedene Datenspeicher"
    },
    {
     "id": "waf5-v2-07-04",
     "level": 1,
     "text": "Festplatte, USB-Stick, CD, E-Mail an die eigene Adresse"
    },
    {
     "id": "waf5-v2-07-05",
     "level": 0,
     "text": "Abschnittsweise ausdrucken"
    }
   ]
  },
  {
   "id": "waf6-v2-01",
   "subject": "Wissenschaftliches Arbeiten – Formalia",
   "title": "WA6 · Was steht auf der Checkliste Text?",
   "status": "neu",
   "lines": [
    {
     "id": "waf6-v2-01-01",
     "level": 0,
     "text": "Abgleich und Verweise"
    },
    {
     "id": "waf6-v2-01-02",
     "level": 1,
     "text": "Überschriften identisch mit dem Inhaltsverzeichnis?"
    },
    {
     "id": "waf6-v2-01-03",
     "level": 1,
     "text": "interne Verweise (Seiten, Kapitel) korrekt?"
    },
    {
     "id": "waf6-v2-01-04",
     "level": 1,
     "text": "alle Seiten richtig nummeriert?"
    },
    {
     "id": "waf6-v2-01-05",
     "level": 0,
     "text": "Sprache"
    },
    {
     "id": "waf6-v2-01-06",
     "level": 1,
     "text": "lange Sätze auf verständliche Länge gekürzt?"
    },
    {
     "id": "waf6-v2-01-07",
     "level": 1,
     "text": "jeder neue Gedanke mit neuem Absatz oder Erstzeileneinzug?"
    },
    {
     "id": "waf6-v2-01-08",
     "level": 1,
     "text": "Ich- und Wir-Aussagen eliminiert?"
    },
    {
     "id": "waf6-v2-01-09",
     "level": 0,
     "text": "Fehler"
    },
    {
     "id": "waf6-v2-01-10",
     "level": 1,
     "text": "Rechtschreibprüfung gemacht, Tippfehler beseitigt?"
    },
    {
     "id": "waf6-v2-01-11",
     "level": 1,
     "text": "Grammatikfehler gesucht, die die Rechtschreibprüfung nicht findet?"
    },
    {
     "id": "waf6-v2-01-12",
     "level": 1,
     "text": "Zeichensetzung geprüft?"
    },
    {
     "id": "waf6-v2-01-13",
     "level": 0,
     "text": "Layout"
    },
    {
     "id": "waf6-v2-01-14",
     "level": 1,
     "text": "automatische Silbentrennung, kein Flatterrand?"
    },
    {
     "id": "waf6-v2-01-15",
     "level": 1,
     "text": "keine einzelne Überschrift oder Absatzzeile allein am Seitenende bzw. -anfang?"
    }
   ]
  },
  {
   "id": "waf6-v2-02",
   "subject": "Wissenschaftliches Arbeiten – Formalia",
   "title": "WA6 · Was steht auf den Checklisten Inhaltsverzeichnis, Quellenangaben und Literaturverzeichnis?",
   "status": "neu",
   "lines": [
    {
     "id": "waf6-v2-02-01",
     "level": 0,
     "text": "Inhaltsverzeichnis: einheitliche Schrift, max. zwei Hervorhebungen, keine Großbuchstaben, keine Unterstreichungen"
    },
    {
     "id": "waf6-v2-02-02",
     "level": 0,
     "text": "Quellenangaben im Text"
    },
    {
     "id": "waf6-v2-02-03",
     "level": 1,
     "text": "Zitierweise einheitlich, immer gleiches Schema"
    },
    {
     "id": "waf6-v2-02-04",
     "level": 1,
     "text": "direkte und indirekte Zitate exakt unterschieden"
    },
    {
     "id": "waf6-v2-02-05",
     "level": 1,
     "text": "Seitenangabe bei direkten Zitaten"
    },
    {
     "id": "waf6-v2-02-06",
     "level": 1,
     "text": "alle Angaben vollständig"
    },
    {
     "id": "waf6-v2-02-07",
     "level": 0,
     "text": "Literaturverzeichnis: Inhalt"
    },
    {
     "id": "waf6-v2-02-08",
     "level": 1,
     "text": "alle zitierten Quellen als Langbeleg erfasst"
    },
    {
     "id": "waf6-v2-02-09",
     "level": 1,
     "text": "Sammelwerk und Einzelbeitrag mit genauer Seitenangabe"
    },
    {
     "id": "waf6-v2-02-10",
     "level": 1,
     "text": "Erscheinungsort und -jahr angegeben"
    },
    {
     "id": "waf6-v2-02-11",
     "level": 1,
     "text": "Zeitungen, Zeitschriften, Sammelwerke mit Anfangs- und Endseite"
    },
    {
     "id": "waf6-v2-02-12",
     "level": 1,
     "text": "Autor:innen ohne Titel (Dr., Prof.)"
    },
    {
     "id": "waf6-v2-02-13",
     "level": 0,
     "text": "Literaturverzeichnis: Form"
    },
    {
     "id": "waf6-v2-02-14",
     "level": 1,
     "text": "alphabetisch nach Nachnamen sortiert"
    },
    {
     "id": "waf6-v2-02-15",
     "level": 1,
     "text": "Namen herausgerückt (negativer Erstzeileneinzug)"
    },
    {
     "id": "waf6-v2-02-16",
     "level": 1,
     "text": "Abstand zwischen Einträgen größer als zwischen den Zeilen eines Eintrags"
    }
   ]
  },
