  {
   "id": "waf5-v2-01",
   "subject": "Wissenschaftliches Arbeiten – Formalia",
   "title": "WA5 · Welche Schrift, Schriftgröße und welcher Zeilenabstand?",
   "status": "neu",
   "lines": [
    {
     "id": "waf5-v2-01-01",
     "level": 0,
     "text": "Schriftarten"
    },
    {
     "id": "waf5-v2-01-02",
     "level": 1,
     "text": "Times New Roman, Calibri, Garamond (Arial, Verdana)"
    },
    {
     "id": "waf5-v2-01-03",
     "level": 0,
     "text": "Schriftgröße"
    },
    {
     "id": "waf5-v2-01-04",
     "level": 1,
     "text": "Fließtext: 12 pt (Arial und Verdana: 11 pt)"
    },
    {
     "id": "waf5-v2-01-05",
     "level": 1,
     "text": "lange wörtliche Zitate (über 3 Zeilen): 10 pt, eingerückt, mit Leerzeile abgesetzt"
    },
    {
     "id": "waf5-v2-01-06",
     "level": 0,
     "text": "Zeilenabstand"
    },
    {
     "id": "waf5-v2-01-07",
     "level": 1,
     "text": "Fließtext: 1,5-zeilig"
    },
    {
     "id": "waf5-v2-01-08",
     "level": 1,
     "text": "längere wörtliche Zitate: 1-zeilig"
    },
    {
     "id": "waf5-v2-01-09",
     "level": 0,
     "text": "Achtung: LV5 schreibt Blockzitate „kursiv\", LV4 (APA) „nicht kursiv\" – im Zweifel nachfragen"
    }
   ]
  },
  {
   "id": "waf5-v2-02",
   "subject": "Wissenschaftliches Arbeiten – Formalia",
   "title": "WA5 · Welche Hervorhebungen gibt es – und ihre Shortcuts?",
   "status": "neu",
   "lines": [
    {
     "id": "waf5-v2-02-01",
     "level": 0,
     "text": "Shortcuts in Word"
    },
    {
     "id": "waf5-v2-02-02",
     "level": 1,
     "text": "Her­vorhe­bung | Shortcut"
    },
    {
     "id": "waf5-v2-02-03",
     "level": 1,
     "text": "Unter­strei­chung | ?Strg + Umsch + U"
    },
    {
     "id": "waf5-v2-02-04",
     "level": 1,
     "text": "Kursiv | ?Strg + Umsch + K"
    },
    {
     "id": "waf5-v2-02-05",
     "level": 1,
     "text": "Fett | ?Strg + Umsch + F"
    },
    {
     "id": "waf5-v2-02-06",
     "level": 1,
     "text": "Kapitälchen | ?Strg + Umsch + Q"
    },
    {
     "id": "waf5-v2-02-07",
     "level": 1,
     "text": "Hoch­stel­lung | ?Strg + +"
    },
    {
     "id": "waf5-v2-02-08",
     "level": 1,
     "text": "Tief­stel­lung | ?Strg + #"
    },
    {
     "id": "waf5-v2-02-09",
     "level": 0,
     "text": "Maximal zwei Hervorhebungsformen verwenden!"
    }
   ]
  },
  {
   "id": "waf5-v2-03",
   "subject": "Wissenschaftliches Arbeiten – Formalia",
   "title": "WA5 · Wie sieht das Seitenlayout aus?",
   "status": "neu",
   "lines": [
    {
     "id": "waf5-v2-03-01",
     "level": 0,
     "text": "Satzspiegel: hochformatig, einseitig (asymmetrisch)"
    },
    {
     "id": "waf5-v2-03-02",
     "level": 0,
     "text": "Seitenränder"
    },
    {
     "id": "waf5-v2-03-03",
     "level": 1,
     "text": "Rand | Breite"
    },
    {
     "id": "waf5-v2-03-04",
     "level": 1,
     "text": "oben | ?2,5 cm"
    },
    {
     "id": "waf5-v2-03-05",
     "level": 1,
     "text": "unten | ?2,5 cm"
    },
    {
     "id": "waf5-v2-03-06",
     "level": 1,
     "text": "links | ?3,0 cm"
    },
    {
     "id": "waf5-v2-03-07",
     "level": 1,
     "text": "rechts | ?2,5 cm"
    },
    {
     "id": "waf5-v2-03-08",
     "level": 0,
     "text": "Seitenzahlen"
    },
    {
     "id": "waf5-v2-03-09",
     "level": 1,
     "text": "rechts unten"
    },
    {
     "id": "waf5-v2-03-10",
     "level": 1,
     "text": "Titelblatt zählt als erste Seite, wird aber nicht nummeriert"
    },
    {
     "id": "waf5-v2-03-11",
     "level": 0,
     "text": "Textausrichtung: Blocksatz, und dann immer mit Silbentrennung"
    },
    {
     "id": "waf5-v2-03-12",
     "level": 0,
     "text": "Absätze: klar gegliedert durch Erstzeileneinzüge oder Absatzabstände"
    }
   ]
  },
  {
   "id": "waf5-v2-04",
   "subject": "Wissenschaftliches Arbeiten – Formalia",
   "title": "WA5 · Wie formatiert man Überschriften?",
   "status": "neu",
   "lines": [
    {
     "id": "waf5-v2-04-01",
     "level": 0,
     "text": "Formatvorlagen"
    },
    {
     "id": "waf5-v2-04-02",
     "level": 1,
     "text": "Vorlage | Schrift­größe | Sonst"
    },
    {
     "id": "waf5-v2-04-03",
     "level": 1,
     "text": "Standard | ?12 pt (11 pt) | Blocksatz, 1,5-zeilig"
    },
    {
     "id": "waf5-v2-04-04",
     "level": 1,
     "text": "Überschrift 1 | ?16 pt | fett, linksbündig, 12 pt Abstand vor und nach, 1,5-zeilig"
    },
    {
     "id": "waf5-v2-04-05",
     "level": 1,
     "text": "Überschrift 2 | ?14 pt | wie Überschrift 1"
    },
    {
     "id": "waf5-v2-04-06",
     "level": 1,
     "text": "Überschrift 3 | ?13 pt | wie Überschrift 1"
    },
    {
     "id": "waf5-v2-04-07",
     "level": 0,
     "text": "Shortcuts: Alt + 1, Alt + 2, Alt + 3"
    },
    {
     "id": "waf5-v2-04-08",
     "level": 0,
     "text": "Überschriften hervorheben durch größere, fette oder kursive Schrift, Kapitälchen, andere Schriftart"
    },
    {
     "id": "waf5-v2-04-09",
     "level": 1,
     "text": "Kombinationen sparsam einsetzen"
    }
   ]
  },
  {
