  {
   "id": "waf3-v2-01",
   "subject": "Wissenschaftliches Arbeiten – Formalia",
   "title": "WA3 · Zahlen: als Wort oder als Ziffer?",
   "status": "neu",
   "lines": [
    {
     "id": "waf3-v2-01-01",
     "level": 0,
     "text": "Als Wort"
    },
    {
     "id": "waf3-v2-01-02",
     "level": 1,
     "text": "kleiner als 12 und ohne konkrete Einheit: drei Items"
    },
    {
     "id": "waf3-v2-01-03",
     "level": 1,
     "text": "am Satzanfang"
    },
    {
     "id": "waf3-v2-01-04",
     "level": 1,
     "text": "gebräuchliche Brüche: ein Achtel"
    },
    {
     "id": "waf3-v2-01-05",
     "level": 0,
     "text": "Als Ziffer, auch unter 12"
    },
    {
     "id": "waf3-v2-01-06",
     "level": 1,
     "text": "unmittelbar vor Messeinheiten: 2 cm"
    },
    {
     "id": "waf3-v2-01-07",
     "level": 1,
     "text": "bei mathematischen oder statistischen Funktionen"
    },
    {
     "id": "waf3-v2-01-08",
     "level": 1,
     "text": "bei Größen, bestimmten Werten, Bezifferungen: 6 Stunden"
    },
    {
     "id": "waf3-v2-01-09",
     "level": 1,
     "text": "an definierter Stelle einer nummerierten Folge: Abbildung 1"
    },
    {
     "id": "waf3-v2-01-10",
     "level": 0,
     "text": "Merkhilfe (grob): kleine Anzahl ohne Einheit = Wort; alles mit Einheit, Wert oder Nummer = Ziffer"
    }
   ]
  },
  {
   "id": "waf3-v2-02",
   "subject": "Wissenschaftliches Arbeiten – Formalia",
   "title": "WA3 · Wie schreibt man Einheiten, Uhrzeiten, Daten und Abkürzungen?",
   "status": "neu",
   "lines": [
    {
     "id": "waf3-v2-02-01",
     "level": 0,
     "text": "Dezimalkomma, Leerzeichen zwischen Zahl und Einheit"
    },
    {
     "id": "waf3-v2-02-02",
     "level": 1,
     "text": "499,99 EUR · 1,55 kg · 13,35 km"
    },
    {
     "id": "waf3-v2-02-03",
     "level": 1,
     "text": "bei ungefähren Angaben darf das Komma entfallen: ca. 3 km"
    },
    {
     "id": "waf3-v2-02-04",
     "level": 0,
     "text": "Uhrzeiten: 08:30 Uhr · 08:30:27 Uhr"
    },
    {
     "id": "waf3-v2-02-05",
     "level": 0,
     "text": "Kalenderdaten: 2009-11-11 · 11.11.2009 · 11. November 2009"
    },
    {
     "id": "waf3-v2-02-06",
     "level": 0,
     "text": "Vorzeichen direkt an der Zahl (-29 °C), alleinstehende Hochzeichen direkt dahinter (45°)"
    },
    {
     "id": "waf3-v2-02-07",
     "level": 0,
     "text": "Abkürzungen"
    },
    {
     "id": "waf3-v2-02-08",
     "level": 1,
     "text": "voll ausgesprochen, also mit Punkt: usw., z. B., bzw."
    },
    {
     "id": "waf3-v2-02-09",
     "level": 1,
     "text": "wie ein Wort gesprochen, also ohne Punkt: AG, GmbH, BGB"
    },
    {
     "id": "waf3-v2-02-10",
     "level": 0,
     "text": "Aneinanderreihungen"
    },
    {
     "id": "waf3-v2-02-11",
     "level": 1,
     "text": "mit Bindestrich: 2-seitig, A4-Format"
    },
    {
     "id": "waf3-v2-02-12",
     "level": 1,
     "text": "Ableitungen ohne Bindestrich: 2005er, 3fach, 100%ig"
    }
   ]
  },
