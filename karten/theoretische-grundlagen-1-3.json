     "text": "Theoretikerin | Werk"
    },
    {
     "id": "tg3-05-02",
     "level": 0,
     "text": "Hildegard Peplau (1909–1999) | ?1952: zwischenmenschliche Beziehungen in der Pflege"
    },
    {
     "id": "tg3-05-03",
     "level": 0,
     "text": "Ida Jean Orlando (1926–2007) | ?1961: dynamische Schwester-Patient-Beziehung"
    },
    {
     "id": "tg3-05-04",
     "level": 0,
     "text": "Paterson & Zderad | ?1961: humanistische Pflege"
    },
    {
     "id": "tg3-05-05",
     "level": 0,
     "text": "Ernestine Wiedenbach (1900–1998) | ?1964: klinische Pflege – eine helfende Kunst"
    },
    {
     "id": "tg3-05-06",
     "level": 0,
     "text": "Joyce Travelbee (1926–1970) | ?1966: zwischenmenschliche Aspekte der Pflege"
    },
    {
     "id": "tg3-05-07",
     "level": 0,
     "text": "Imogene King (1923–2007) | ?1971: Pflege als Prozess von Aktion, Reaktion, Interaktion, Transaktion"
    }
   ]
  },
  {
   "id": "tg3-06",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG3 · Die Denkschule der Interaktion",
   "status": "neu",
   "lines": [
    {
     "id": "tg3-06-01",
     "level": 0,
     "text": "Fokus"
    },
    {
     "id": "tg3-06-02",
     "level": 1,
     "text": "Pflegekraft-Patient-Interaktion"
    },
    {
     "id": "tg3-06-03",
     "level": 1,
     "text": "Krankheit als Erfahrung, interagierendes Wesen"
    },
    {
     "id": "tg3-06-04",
     "level": 0,
     "text": "Person"
    },
    {
     "id": "tg3-06-05",
     "level": 1,
     "text": "Set von Bedürfnissen, kann Bedürfnisse validieren"
    },
    {
     "id": "tg3-06-06",
     "level": 1,
     "text": "menschliche Erfahrung mit Sinn"
    },
    {
     "id": "tg3-06-07",
     "level": 0,
     "text": "Patient:in"
    },
    {
     "id": "tg3-06-08",
     "level": 1,
     "text": "hilfloses Wesen, menschliche Erfahrung mit Sinn"
    },
    {
     "id": "tg3-06-09",
     "level": 0,
     "text": "Orientierung"
    },
    {
     "id": "tg3-06-10",
     "level": 1,
     "text": "Krankheit, Leiden"
    },
    {
     "id": "tg3-06-11",
     "level": 0,
     "text": "Rolle der Pflegekraft"
    },
    {
     "id": "tg3-06-12",
     "level": 1,
     "text": "bewusster Prozess des Helfens"
    },
    {
     "id": "tg3-06-13",
     "level": 1,
     "text": "das Selbst als therapeutischer Agent, Anwendung des Pflegeprozesses"
    },
    {
     "id": "tg3-06-14",
     "level": 0,
     "text": "Entscheidungsträger"
    },
    {
     "id": "tg3-06-15",
     "level": 1,
     "text": "Fachleute der Grundversorgung, von den Klient:innen validiert"
    }
   ]
  },
  {
