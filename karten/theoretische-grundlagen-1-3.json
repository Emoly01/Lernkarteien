  {
   "id": "tg3-11",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG3 · Fragen zur kritischen Reflexion einer Theorie",
   "status": "neu",
   "lines": [
    {
     "id": "tg3-11-01",
     "level": 0,
     "text": "Wie verständlich ist die Theorie?"
    },
    {
     "id": "tg3-11-02",
     "level": 0,
     "text": "Wie pragmatisch ist sie?"
    },
    {
     "id": "tg3-11-03",
     "level": 0,
     "text": "Wie allgemeingültig ist sie?"
    },
    {
     "id": "tg3-11-04",
     "level": 0,
     "text": "Wie erreichbar bzw. zugänglich ist sie?"
    },
    {
     "id": "tg3-11-05",
     "level": 0,
     "text": "Wie substanziell ist sie?"
    },
    {
     "id": "tg3-11-06",
