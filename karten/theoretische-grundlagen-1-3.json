   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG3 · Was kennzeichnet die Denkschule der Bedürfnisse?",
   "status": "neu",
   "lines": [
    {
     "id": "tg3-v2-04-01",
     "level": 0,
     "text": "Fokus"
    },
    {
     "id": "tg3-v2-04-02",
     "level": 1,
     "text": "Problem, Funktion der Pflegekraft"
    },
    {
     "id": "tg3-v2-04-03",
     "level": 0,
     "text": "Person"
    },
    {
     "id": "tg3-v2-04-04",
     "level": 1,
     "text": "Set von Bedürfnissen oder Problemen, Wesen, das sich entwickelt"
    },
    {
     "id": "tg3-v2-04-05",
     "level": 0,
     "text": "Patient:in"
    },
    {
