   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG3 · Was kritisieren Moers, Schaeffer & Steppe an Pflegetheorien?",
   "status": "neu",
   "lines": [
    {
     "id": "tg3-v2-12-01",
     "level": 0,
     "text": "Viele Theorien sind eher verallgemeinertes Alltagswissen"
    },
    {
     "id": "tg3-v2-12-02",
     "level": 1,
     "text": "niedrige Allgemeinheitsstufe, kaum theoretische Fundierung"
    },
