  {
   "id": "tg1-02",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG1 · Was ist ein Konzept?",
   "status": "neu",
   "lines": [
    {
     "id": "tg1-02-01",
     "level": 0,
     "text": "Konzept (dt.) = Idee oder Plan; concept (engl.) = Begriff"
    },
    {
     "id": "tg1-02-02",
     "level": 0,
     "text": "Beschreibt ein Phänomen oder eine Gruppe von Phänomenen"
    },
    {
     "id": "tg1-02-03",
     "level": 0,
     "text": "Abstrakte Verallgemeinerung beobachteter Sachverhalte"
    },
    {
     "id": "tg1-02-04",
     "level": 0,
     "text": "Annahmen verbinden Konzepte miteinander"
    },
    {
     "id": "tg1-02-05",
     "level": 0,
     "text": "Konzepte sind die kleinsten Bausteine einer Theorie"
    }
   ]
  },
  {
   "id": "tg1-03",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG1 · Was ist ein Modell?",
   "status": "neu",
   "lines": [
    {
     "id": "tg1-03-01",
     "level": 0,
     "text": "Vereinfachte und modifizierte Darstellung eines tatsächlichen Sachverhalts"
    },
    {
     "id": "tg1-03-02",
     "level": 1,
     "text": "gegenständliche bzw. empirische Modelle"
    },
    {
     "id": "tg1-03-03",
     "level": 1,
     "text": "abstrakte bzw. theoretische Modelle"
    },
    {
     "id": "tg1-03-04",
     "level": 0,
     "text": "Merkmale (Neumann-Ponesch, 2021)"
    },
    {
     "id": "tg1-03-05",
     "level": 1,
     "text": "Reduktion der Realität"
    },
    {
     "id": "tg1-03-06",
     "level": 1,
     "text": "Hervorhebung von Perspektiven des sozialen Umfelds"
    },
    {
     "id": "tg1-03-07",
     "level": 1,
     "text": "Schaffung von Übersichtlichkeit"
    }
   ]
  },
  {
   "id": "tg1-04",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG1 · Pflegemodelle – Anforderungen",
   "status": "neu",
   "lines": [
    {
     "id": "tg1-04-01",
     "level": 0,
     "text": "Abstrakte Modelle von dem, was Pflege ist oder sein sollte"
    },
    {
     "id": "tg1-04-02",
     "level": 0,
     "text": "Sollten …"
    },
    {
     "id": "tg1-04-03",
     "level": 1,
     "text": "systematisch aufgebaut sein"
    },
    {
     "id": "tg1-04-04",
     "level": 1,
     "text": "eine wissenschaftliche Grundlage haben"
    },
    {
     "id": "tg1-04-05",
     "level": 1,
     "text": "logisch verknüpfte Bestandteile haben"
    },
    {
     "id": "tg1-04-06",
     "level": 1,
     "text": "auf Verwendbarkeit und Gültigkeit in der Praxis überprüft werden"
    }
   ]
  },
  {
   "id": "tg1-05",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG1 · Was ist eine Theorie? (Meleis)",
   "status": "neu",
   "lines": [
    {
     "id": "tg1-05-01",
     "level": 0,
     "text": "Bündel von Ideen oder erklärenden Vermutungen"
    },
    {
     "id": "tg1-05-02",
     "level": 0,
     "text": "Für einen speziellen Zweck konstruiert"
    },
    {
     "id": "tg1-05-03",
     "level": 0,
     "text": "Systematische Abstraktion"
    },
    {
     "id": "tg1-05-04",
     "level": 1,
     "text": "strukturiert die zugrunde liegenden Phänomene"
    },
    {
     "id": "tg1-05-05",
     "level": 1,
     "text": "Theorie ist nicht mit der Wirklichkeit identisch"
    },
    {
     "id": "tg1-05-06",
     "level": 0,
     "text": "Besteht aus Konzepten"
    },
    {
     "id": "tg1-05-07",
     "level": 0,
     "text": "Zweck: Beschreibung, Erklärung, Vorhersage"
    },
    {
     "id": "tg1-05-08",
     "level": 0,
     "text": "Pflegetheorie = Konzeptualisierung einiger Aspekte der Pflegerealität"
    }
   ]
  },
  {
   "id": "tg1-06",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG1 · Theorienmonismus vs. Theorienpluralismus",
   "status": "neu",
   "lines": [
    {
     "id": "tg1-06-01",
     "level": 0,
     "text": "Theorienmonismus"
    },
    {
     "id": "tg1-06-02",
     "level": 1,
     "text": "eine umfassende, allgemeingültige Theorie der Pflege"
    },
    {
     "id": "tg1-06-03",
     "level": 0,
     "text": "Theorienpluralismus"
    },
    {
     "id": "tg1-06-04",
     "level": 1,
     "text": "verschiedene, widerstreitende und teils überlappende Theorien sind gleichzeitig einflussreich"
    },
    {
     "id": "tg1-06-05",
     "level": 0,
     "text": "Evers (1991): Pflege ist so komplex, dass theoretischer Pluralismus notwendig ist"
    },
    {
     "id": "tg1-06-06",
     "level": 1,
     "text": "die alles erklärende Pflegetheorie ist eine Illusion"
    }
   ]
  },
  {
   "id": "tg1-07",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG1 · Warum braucht die Pflege Theorien?",
   "status": "neu",
   "lines": [
    {
     "id": "tg1-07-01",
     "level": 0,
     "text": "Unverzichtbar, weil sie … (Chinn & Kramer)"
    },
    {
     "id": "tg1-07-02",
     "level": 1,
     "text": "eine fundierte Grundlage für die Praxis bieten"
    },
    {
     "id": "tg1-07-03",
     "level": 1,
     "text": "professionelle Identität stiften"
    },
    {
     "id": "tg1-07-04",
     "level": 1,
     "text": "Meinungsverschiedenheiten darüber, was in der Pflege machbar ist, ausräumen"
    },
    {
     "id": "tg1-07-05",
     "level": 1,
     "text": "Grundlage für bewusste Entscheidungen sind"
    },
    {
     "id": "tg1-07-06",
     "level": 0,
     "text": "„Kolumbus ist nicht ziellos umhergereist. Er segelte nach Westen aufgrund einer plausiblen Theorie.\""
    }
   ]
  },
