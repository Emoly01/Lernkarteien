  {
   "id": "tg2-v2-11",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG2 · Was sind Thesen in der Theoriebildung?",
   "status": "neu",
   "lines": [
    {
     "id": "tg2-v2-11-01",
     "level": 0,
     "text": "Wichtiger Bestandteil des wissenschaftlichen Wissensgebäudes"
    },
    {
     "id": "tg2-v2-11-02",
     "level": 0,
     "text": "Muss definiert sein, bevor man Erklärungen und Prognosen aufstellt"
    },
    {
     "id": "tg2-v2-11-03",
     "level": 0,
     "text": "Synonyme: Vorschlag, Behauptung, Aussage"
    },
    {
     "id": "tg2-v2-11-04",
     "level": 0,
     "text": "Arten"
    },
    {
     "id": "tg2-v2-11-05",
     "level": 1,
     "text": "These → relationale These"
    },
    {
     "id": "tg2-v2-11-06",
     "level": 1,
     "text": "These → nicht-relationale These"
    },
    {
     "id": "tg2-v2-11-07",
     "level": 1,
     "text": "relationale These → assoziative These"
    },
    {
     "id": "tg2-v2-11-08",
     "level": 1,
     "text": "relationale These → kausale These"
    }
   ]
  },
  {
   "id": "tg2-v2-12",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG2 · Was ist eine Theorie nach Walker & Avant?",
   "status": "neu",
   "lines": [
    {
     "id": "tg2-v2-12-01",
     "level": 0,
     "text": "In sich konsistente Gruppe relationaler Thesen"
    },
    {
     "id": "tg2-v2-12-02",
     "level": 0,
     "text": "Systematische Sicht eines Phänomens"
    },
    {
     "id": "tg2-v2-12-03",
     "level": 0,
     "text": "Nützlich für Beschreibung, Erklärung, Vorhersage und/oder Kontrolle"
    },
    {
     "id": "tg2-v2-12-04",
     "level": 0,
     "text": "Bringt eine neue Vorstellung oder Einsicht in ein Phänomen zum Ausdruck"
    },
    {
     "id": "tg2-v2-12-05",
     "level": 0,
     "text": "Bausteine: Begriffe → Thesen → Theorie"
    }
   ]
  },
  {
   "id": "tg2-v2-13",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG2 · Theorie bei Meleis und bei Walker & Avant – was ist anders?",
   "status": "neu",
   "lines": [
    {
     "id": "tg2-v2-13-01",
     "level": 0,
     "text": "Kern"
