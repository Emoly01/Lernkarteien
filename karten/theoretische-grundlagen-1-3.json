     "text": "deutsch | Fachbegriff"
    },
    {
     "id": "tg2-v2-08-05",
     "level": 1,
     "text": "beschrei­bend | ?deskriptiv"
    },
    {
     "id": "tg2-v2-08-06",
     "level": 1,
     "text": "erklärend | ?explanativ"
    },
    {
     "id": "tg2-v2-08-07",
     "level": 1,
     "text": "vor­aussa­gend | ?pro­gnos­tisch"
    },
    {
     "id": "tg2-v2-08-08",
     "level": 1,
     "text": "vor­schrei­bend | ?präskriptiv"
    },
    {
     "id": "tg2-v2-08-09",
     "level": 0,
     "text": "Jede innere Stufe setzt die äußeren voraus"
    },
    {
     "id": "tg2-v2-08-10",
     "level": 0,
     "text": "Nicht verwechseln mit Huninks 7 Funktionen (Bezugsrahmen, Ratgeber … TG1)"
    }
   ]
  },
  {
