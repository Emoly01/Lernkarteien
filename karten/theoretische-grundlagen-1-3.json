  {
   "id": "tg3-04",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG3 · Die Denkschule der Bedürfnisse",
   "status": "neu",
   "lines": [
    {
     "id": "tg3-04-01",
     "level": 0,
     "text": "Fokus"
    },
    {
     "id": "tg3-04-02",
     "level": 1,
     "text": "Problem, Funktion der Pflegekraft"
    },
    {
     "id": "tg3-04-03",
     "level": 0,
     "text": "Person"
    },
    {
     "id": "tg3-04-04",
     "level": 1,
     "text": "Set von Bedürfnissen oder Problemen, Wesen, das sich entwickelt"
    },
    {
     "id": "tg3-04-05",
     "level": 0,
     "text": "Patient:in"
    },
    {
     "id": "tg3-04-06",
     "level": 1,
     "text": "Bedürfnisdefizit"
    },
    {
     "id": "tg3-04-07",
     "level": 0,
     "text": "Orientierung"
    },
    {
     "id": "tg3-04-08",
     "level": 1,
     "text": "Krankheit, Leiden"
    },
    {
     "id": "tg3-04-09",
     "level": 0,
     "text": "Rolle der Pflegekraft"
    },
    {
     "id": "tg3-04-10",
     "level": 1,
     "text": "von der Medizin abhängig, Anfänge unabhängiger Funktion"
    },
    {
     "id": "tg3-04-11",
     "level": 1,
     "text": "Erfüllung von Bedürfnissen und Erfordernissen"
    },
    {
     "id": "tg3-04-12",
     "level": 0,
     "text": "Entscheidungsträger"
    },
    {
     "id": "tg3-04-13",
     "level": 1,
     "text": "Fachleute der gesundheitlichen Grundversorgung"
    }
   ]
  },
  {
   "id": "tg3-05",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG3 · Interaktionstheoretikerinnen",
   "status": "neu",
   "lines": [
    {
     "id": "tg3-05-01",
