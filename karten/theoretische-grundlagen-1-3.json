   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG2 · Wie klassifiziert Meleis Theorien?",
   "status": "neu",
   "lines": [
    {
     "id": "tg2-v2-01-01",
     "level": 0,
     "text": "Große Theorien (grand theories)"
    },
    {
     "id": "tg2-v2-01-02",
     "level": 1,
     "text": "systematische Konstruktionen des Wesens und der Aufgaben der Pflege und der Ziele pflegerischer Fürsorge"
    },
    {
     "id": "tg2-v2-01-03",
     "level": 0,
     "text": "Theorien mittlerer Reichweite (middle range theories)"
    },
    {
     "id": "tg2-v2-01-04",
     "level": 1,
     "text": "behandeln spezifische Phänomene"
    },
    {
     "id": "tg2-v2-01-05",
     "level": 0,
     "text": "Situationsspezifische Theorien"
    },
    {
     "id": "tg2-v2-01-06",
     "level": 1,
     "text": "konzentrieren sich auf ein spezifisches Pflegephänomen"
    }
   ]
  },
  {
   "id": "tg2-v2-02",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG2 · Was ist das Metaparadigma der Pflege? (Fawcett)",
   "status": "neu",
   "lines": [
    {
     "id": "tg2-v2-02-01",
     "level": 0,
     "text": "Geltungsbereich, in dem sich eine Disziplin von anderen unterscheidet"
    },
    {
     "id": "tg2-v2-02-02",
     "level": 0,
     "text": "Perspektivneutral, international gültig"
    },
    {
     "id": "tg2-v2-02-03",
     "level": 0,
     "text": "Vier Konzepte der Pflege"
    },
    {
     "id": "tg2-v2-02-04",
     "level": 1,
     "text": "Konzept | Merkwort"
    },
    {
     "id": "tg2-v2-02-05",
     "level": 1,
     "text": "?Person | wer?"
    },
    {
     "id": "tg2-v2-02-06",
     "level": 1,
     "text": "?Umwelt | wo?"
    },
    {
     "id": "tg2-v2-02-07",
     "level": 1,
     "text": "?Gesundheit | wozu?"
    },
    {
     "id": "tg2-v2-02-08",
     "level": 1,
     "text": "?Pflege | wie?"
    },
    {
     "id": "tg2-v2-02-09",
     "level": 0,
     "text": "Merkhilfe: „Person in ihrer Umwelt, Gesundheit durch Pflege\""
    }
   ]
  },
  {
   "id": "tg2-v2-03",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG2 · Wie klassifiziert Fawcett das Pflegewissen?",
   "status": "neu",
   "lines": [
    {
     "id": "tg2-v2-03-01",
     "level": 0,
     "text": "Metaparadigma"
    },
    {
     "id": "tg2-v2-03-02",
     "level": 1,
     "text": "Person, Umwelt, Gesundheit, Pflege"
    },
    {
     "id": "tg2-v2-03-03",
     "level": 0,
     "text": "Konzeptuelle Modelle"
    },
    {
     "id": "tg2-v2-03-04",
     "level": 1,
     "text": "abstrakte, allgemeine Vorstellungen; beschreiben den Gesamtgegenstand der Pflege"
    },
    {
     "id": "tg2-v2-03-05",
     "level": 1,
     "text": "setzen Person, Umwelt, Gesundheit und Pflege in Beziehung"
    },
    {
     "id": "tg2-v2-03-06",
     "level": 1,
     "text": "empirisch nicht überprüfbar"
    },
    {
     "id": "tg2-v2-03-07",
     "level": 0,
     "text": "Theorien"
    },
    {
     "id": "tg2-v2-03-08",
     "level": 1,
     "text": "relativ spezifische Begriffe und Aussagen zu bestimmten Phänomenen, in geordnetem Rahmen"
    },
    {
     "id": "tg2-v2-03-09",
     "level": 0,
     "text": "Empirische Indikatoren"
    },
    {
     "id": "tg2-v2-03-10",
     "level": 1,
     "text": "Instrumente, experimentelle Bedingungen und Verfahren"
    }
   ]
  },
  {
   "id": "tg2-v2-04",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG2 · Wie klassifizieren Walker & Avant Theorien?",
   "status": "neu",
   "lines": [
    {
     "id": "tg2-v2-04-01",
     "level": 0,
     "text": "Metatheorien"
    },
    {
     "id": "tg2-v2-04-02",
     "level": 1,
     "text": "generelle theoretische Probleme, Theorien über Theorien"
    },
    {
     "id": "tg2-v2-04-03",
     "level": 1,
     "text": "nicht empirisch überprüfbar"
    },
    {
     "id": "tg2-v2-04-04",
     "level": 0,
     "text": "Globale Theorien"
    },
    {
     "id": "tg2-v2-04-05",
     "level": 1,
     "text": "umfassende Perspektive für Ziele und Strukturen der Pflege"
    },
    {
     "id": "tg2-v2-04-06",
     "level": 1,
     "text": "nicht empirisch überprüfbar"
    },
    {
     "id": "tg2-v2-04-07",
     "level": 0,
     "text": "Theorien mittlerer Reichweite"
    },
    {
     "id": "tg2-v2-04-08",
     "level": 1,
     "text": "wenige Konzepte, begrenzte Zahl an Variablen"
    },
    {
     "id": "tg2-v2-04-09",
     "level": 1,
     "text": "empirisch überprüfbar"
    },
    {
     "id": "tg2-v2-04-10",
     "level": 0,
     "text": "Praxisnahe Theorien"
    },
    {
     "id": "tg2-v2-04-11",
     "level": 1,
     "text": "Ziel: Handlungsanweisungen"
    },
    {
     "id": "tg2-v2-04-12",
     "level": 1,
     "text": "kleiner, detailliert beschriebener Ausschnitt der Pflege, direkt umsetzbar"
    },
    {
     "id": "tg2-v2-04-13",
     "level": 0,
     "text": "Merkhilfe: empirisch überprüfbar erst ab mittlerer Reichweite"
    }
   ]
  },
