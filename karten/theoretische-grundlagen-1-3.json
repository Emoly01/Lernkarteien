    {
     "id": "tg2-v2-13-04",
     "level": 0,
     "text": "Bausteine und Zweck"
    },
    {
     "id": "tg2-v2-13-05",
     "level": 1,
     "text": "Meleis | Walker & Avant"
    },
    {
     "id": "tg2-v2-13-06",
     "level": 1,
     "text": "?Konzepte | ?Begriffe, dann Thesen"
