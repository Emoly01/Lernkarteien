  {
   "id": "tg2-01",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG2 · Klassifikation nach Meleis",
   "status": "neu",
   "lines": [
    {
     "id": "tg2-01-01",
     "level": 0,
     "text": "Große Theorien (grand theories)"
    },
    {
     "id": "tg2-01-02",
     "level": 1,
     "text": "systematische Konstruktionen des Wesens und der Aufgaben der Pflege und der Ziele pflegerischer Fürsorge"
    },
    {
     "id": "tg2-01-03",
     "level": 0,
     "text": "Theorien mittlerer Reichweite (middle range theories)"
    },
    {
     "id": "tg2-01-04",
     "level": 1,
     "text": "behandeln spezifische Phänomene"
    },
    {
     "id": "tg2-01-05",
     "level": 0,
     "text": "Situationsspezifische Theorien"
    },
    {
     "id": "tg2-01-06",
     "level": 1,
     "text": "konzentrieren sich auf ein spezifisches Pflegephänomen"
    }
   ]
  },
  {
   "id": "tg2-02",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG2 · Klassifikation nach Fawcett",
   "status": "neu",
   "lines": [
    {
     "id": "tg2-02-01",
     "level": 0,
     "text": "Metaparadigma"
    },
    {
     "id": "tg2-02-02",
     "level": 1,
     "text": "Geltungsbereich, in dem sich eine Disziplin von anderen unterscheidet"
    },
    {
     "id": "tg2-02-03",
     "level": 1,
     "text": "perspektivneutral, international gültig"
    },
    {
     "id": "tg2-02-04",
     "level": 1,
     "text": "für die Pflege: Person, Umwelt, Gesundheit, Pflege"
    },
    {
     "id": "tg2-02-05",
     "level": 0,
     "text": "Konzeptuelle Modelle"
    },
    {
     "id": "tg2-02-06",
     "level": 1,
     "text": "abstrakte, allgemeine Vorstellungen; beschreiben den Gesamtgegenstand der Pflege"
    },
    {
     "id": "tg2-02-07",
     "level": 1,
     "text": "setzen Person, Umwelt, Gesundheit und Pflege in Beziehung"
    },
    {
     "id": "tg2-02-08",
     "level": 1,
     "text": "empirisch nicht überprüfbar"
    },
    {
     "id": "tg2-02-09",
     "level": 0,
     "text": "Theorien"
    },
    {
     "id": "tg2-02-10",
     "level": 1,
     "text": "relativ spezifische Begriffe und Aussagen zu bestimmten Phänomenen, in geordnetem Rahmen"
    },
    {
     "id": "tg2-02-11",
     "level": 0,
     "text": "Empirische Indikatoren"
    },
    {
     "id": "tg2-02-12",
     "level": 1,
     "text": "Instrumente, experimentelle Bedingungen und Verfahren"
    }
   ]
  },
  {
   "id": "tg2-03",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG2 · Klassifikation nach Walker & Avant",
   "status": "neu",
   "lines": [
    {
     "id": "tg2-03-01",
     "level": 0,
     "text": "Metatheorien"
    },
    {
     "id": "tg2-03-02",
     "level": 1,
     "text": "generelle theoretische Probleme, Theorien über Theorien"
    },
    {
     "id": "tg2-03-03",
     "level": 1,
     "text": "nicht empirisch überprüfbar"
    },
    {
     "id": "tg2-03-04",
     "level": 0,
     "text": "Globale Theorien"
    },
    {
     "id": "tg2-03-05",
     "level": 1,
     "text": "umfassende Perspektive für Ziele und Strukturen der Pflege"
    },
    {
     "id": "tg2-03-06",
     "level": 1,
     "text": "nicht empirisch überprüfbar"
    },
    {
     "id": "tg2-03-07",
     "level": 0,
     "text": "Theorien mittlerer Reichweite"
    },
    {
     "id": "tg2-03-08",
     "level": 1,
     "text": "wenige Konzepte, begrenzte Zahl an Variablen"
    },
    {
     "id": "tg2-03-09",
     "level": 1,
     "text": "empirisch überprüfbar"
    },
    {
     "id": "tg2-03-10",
     "level": 0,
     "text": "Praxisnahe Theorien"
    },
    {
     "id": "tg2-03-11",
     "level": 1,
     "text": "Ziel: Handlungsanweisungen"
    },
    {
     "id": "tg2-03-12",
     "level": 1,
     "text": "kleiner, detailliert beschriebener Ausschnitt der Pflege, direkt umsetzbar"
    }
   ]
  },
  {
   "id": "tg2-04",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG2 · Walker & Avant: wie die Ebenen zusammenhängen",
   "status": "neu",
   "lines": [
    {
     "id": "tg2-04-01",
     "level": 0,
     "text": "Von oben nach unten"
    },
    {
     "id": "tg2-04-02",
     "level": 1,
     "text": "Metatheorien klären globale Theorien"
    },
    {
     "id": "tg2-04-03",
     "level": 1,
     "text": "globale Theorien leiten Theorien mittlerer Reichweite"
    },
    {
     "id": "tg2-04-04",
     "level": 1,
     "text": "Theorien mittlerer Reichweite bestimmen praxisnahe Theorien"
    },
    {
     "id": "tg2-04-05",
     "level": 0,
     "text": "Von unten nach oben"
    },
    {
     "id": "tg2-04-06",
     "level": 1,
     "text": "praxisnahe Theorien überprüfen mittlere Theorien praktisch"
    },
    {
     "id": "tg2-04-07",
     "level": 1,
     "text": "mittlere Theorien klären und vervollständigen globale Theorien"
    },
    {
     "id": "tg2-04-08",
     "level": 1,
     "text": "globale Theorien liefern Material für Metatheorien"
    }
   ]
  },
  {
   "id": "tg2-05",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG2 · Klassifikation nach Hunink",
   "status": "neu",
   "lines": [
    {
     "id": "tg2-05-01",
     "level": 0,
     "text": "Meta-Theorie (der Rahmen)"
    },
    {
     "id": "tg2-05-02",
     "level": 0,
     "text": "Haupttheorie: wie eine Landkarte des ganzen D-A-CH-Raums"
    },
    {
     "id": "tg2-05-03",
     "level": 0,
     "text": "Theorie mittlerer Reichweite: wie eine Karte eines Bundeslands"
    },
    {
     "id": "tg2-05-04",
     "level": 0,
     "text": "Theorie der Mikroebene: wie ein Stadtplan"
    }
   ]
  },
  {
   "id": "tg2-06",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG2 · Die vier Klassifikationen im Vergleich",
   "status": "neu",
   "lines": [
    {
     "id": "tg2-06-01",
     "level": 0,
     "text": "Oberste Ebene"
    },
    {
     "id": "tg2-06-02",
     "level": 1,
     "text": "Fawcett: Metaparadigma, Philosophie"
    },
    {
     "id": "tg2-06-03",
     "level": 1,
     "text": "Walker & Avant: Metatheorien"
    },
    {
     "id": "tg2-06-04",
     "level": 0,
     "text": "Große Ebene"
    },
    {
     "id": "tg2-06-05",
     "level": 1,
     "text": "Meleis: große Theorien"
    },
    {
     "id": "tg2-06-06",
     "level": 1,
     "text": "Fawcett: konzeptuelle Modelle"
    },
    {
     "id": "tg2-06-07",
     "level": 1,
     "text": "Walker & Avant: globale Theorien"
    },
    {
     "id": "tg2-06-08",
     "level": 1,
     "text": "Hunink: Haupttheorie"
    },
    {
     "id": "tg2-06-09",
     "level": 0,
     "text": "Mittlere Ebene"
    },
    {
     "id": "tg2-06-10",
     "level": 1,
     "text": "Meleis, Walker & Avant, Hunink: Theorien mittlerer Reichweite"
    },
    {
     "id": "tg2-06-11",
     "level": 1,
     "text": "Fawcett: Theorien"
    },
    {
     "id": "tg2-06-12",
     "level": 0,
     "text": "Unterste Ebene"
    },
    {
     "id": "tg2-06-13",
     "level": 1,
     "text": "Meleis: situationsspezifische Theorien"
    },
    {
     "id": "tg2-06-14",
     "level": 1,
     "text": "Fawcett: empirische Indikatoren"
    },
    {
     "id": "tg2-06-15",
     "level": 1,
     "text": "Walker & Avant: praxisnahe Theorien"
    },
    {
     "id": "tg2-06-16",
     "level": 1,
     "text": "Hunink: Theorie der Mikroebene"
    }
   ]
  },
  {
   "id": "tg2-07",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG2 · Funktion von Theorien (Hunink)",
   "status": "neu",
   "lines": [
    {
     "id": "tg2-07-01",
     "level": 0,
     "text": "Nach ihrer Beziehung zur Realität, von außen nach innen"
    },
    {
     "id": "tg2-07-02",
     "level": 0,
     "text": "beschreibend → erklärend → voraussagend → vorschreibend"
    },
    {
     "id": "tg2-07-03",
     "level": 0,
     "text": "Beschreibend: deskriptiv"
    },
    {
     "id": "tg2-07-04",
     "level": 0,
     "text": "Erklärend: explanativ"
    },
    {
     "id": "tg2-07-05",
     "level": 0,
     "text": "Voraussagend: prognostisch"
    },
    {
     "id": "tg2-07-06",
     "level": 0,
     "text": "Vorschreibend: präskriptiv"
    },
    {
     "id": "tg2-07-07",
     "level": 0,
     "text": "Jede innere Stufe setzt die äußeren voraus"
    }
   ]
  },
  {
   "id": "tg2-08",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG2 · Ebenen von Theorien (Dickoff & James)",
   "status": "neu",
   "lines": [
    {
     "id": "tg2-08-01",
     "level": 0,
     "text": "Pyramide, von unten nach oben"
    },
    {
     "id": "tg2-08-02",
     "level": 0,
     "text": "faktorenisolierend → faktorenbezogen → situationsbezogen → situationsherstellend"
    },
    {
     "id": "tg2-08-03",
     "level": 0,
     "text": "Die Spitze (situationsherstellend) ist die höchste Ebene"
    }
   ]
  },
  {
   "id": "tg2-09",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG2 · Begriffe in der Theoriebildung (Walker & Avant)",
   "status": "neu",
   "lines": [
    {
     "id": "tg2-09-01",
     "level": 0,
     "text": "Elementarste Bausteine jeder Theorie"
    },
    {
     "id": "tg2-09-02",
     "level": 0,
     "text": "Geistiges Bild eines Phänomens, Idee oder gedankliche Vorstellung von Dingen oder Ereignissen"
    },
    {
     "id": "tg2-09-03",
     "level": 0,
     "text": "Helfen festzustellen, wie vergleichbar Erfahrungen sind"
    },
    {
     "id": "tg2-09-04",
     "level": 0,
     "text": "Erlauben, Erfahrungen zu klassifizieren"
    },
    {
     "id": "tg2-09-05",
     "level": 0,
     "text": "Arten"
    },
    {
     "id": "tg2-09-06",
     "level": 1,
     "text": "elementare Begriffe"
    },
    {
     "id": "tg2-09-07",
     "level": 1,
     "text": "konkrete Begriffe"
    },
    {
     "id": "tg2-09-08",
     "level": 1,
     "text": "abstrakte Begriffe"
    }
   ]
  },
  {
   "id": "tg2-10",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG2 · Thesen in der Theoriebildung",
   "status": "neu",
   "lines": [
    {
     "id": "tg2-10-01",
     "level": 0,
     "text": "Wichtiger Bestandteil des wissenschaftlichen Wissensgebäudes"
    },
    {
     "id": "tg2-10-02",
     "level": 0,
     "text": "Muss definiert sein, bevor man Erklärungen und Prognosen aufstellt"
    },
    {
     "id": "tg2-10-03",
     "level": 0,
     "text": "Synonyme: Vorschlag, Behauptung, Aussage"
    },
    {
     "id": "tg2-10-04",
     "level": 0,
     "text": "Arten"
    },
    {
     "id": "tg2-10-05",
     "level": 1,
     "text": "These → relationale These"
    },
    {
     "id": "tg2-10-06",
     "level": 1,
     "text": "These → nicht-relationale These"
    },
    {
     "id": "tg2-10-07",
     "level": 1,
     "text": "relationale These → assoziative These"
    },
    {
     "id": "tg2-10-08",
     "level": 1,
     "text": "relationale These → kausale These"
    }
   ]
  },
  {
   "id": "tg2-11",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG2 · Theorie nach Walker & Avant",
   "status": "neu",
   "lines": [
    {
     "id": "tg2-11-01",
     "level": 0,
     "text": "In sich konsistente Gruppe relationaler Thesen"
    },
    {
     "id": "tg2-11-02",
     "level": 0,
     "text": "Stellt eine systematische Sicht eines Phänomens dar"
    },
    {
     "id": "tg2-11-03",
     "level": 0,
     "text": "Nützlich für Beschreibung, Erklärung, Vorhersage und/oder Kontrolle"
    },
    {
     "id": "tg2-11-04",
     "level": 0,
     "text": "Bringt eine neue Vorstellung oder Einsicht in ein Phänomen zum Ausdruck"
    },
    {
     "id": "tg2-11-05",
     "level": 0,
     "text": "Bausteine: Begriffe → Thesen → Theorie"
    }
   ]
  },
  {
   "id": "tg2-12",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG2 · Prozesse der Theorieentwicklung (Chinn & Kramer)",
   "status": "neu",
   "lines": [
    {
     "id": "tg2-12-01",
     "level": 0,
     "text": "Konzeptuelle Bedeutung schaffen → Theorie strukturieren und kontextualisieren → Theoretische Beziehungen generieren und überprüfen → Theorie gezielt anwenden → Konzeptuelle Bedeutung schaffen"
    }
   ]
  },
  {
   "id": "tg2-13",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG2 · Anwendungsbereiche von Theorien (Meleis)",
   "status": "neu",
   "lines": [
    {
     "id": "tg2-13-01",
     "level": 0,
     "text": "Forschung"
    },
    {
     "id": "tg2-13-02",
     "level": 1,
     "text": "begrenzt die Art der Fragen und die anwendbaren Methoden"
    },
    {
     "id": "tg2-13-03",
     "level": 0,
     "text": "Praxis"
    },
    {
     "id": "tg2-13-04",
     "level": 1,
     "text": "gibt der Pflegekraft Ziele für Einschätzung, Diagnose und Intervention"
    }
   ]
  },
  {
   "id": "tg3-01",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG3 · Komponenten einer Theorie (Chinn & Kramer)",
   "status": "neu",
   "lines": [
    {
     "id": "tg3-01-01",
     "level": 0,
     "text": "Was ist der Zweck der Theorie?"
    },
    {
     "id": "tg3-01-02",
     "level": 0,
     "text": "Welche Konzepte hat sie?"
    },
    {
     "id": "tg3-01-03",
     "level": 0,
     "text": "Wie sind die Konzepte definiert?"
    },
    {
     "id": "tg3-01-04",
     "level": 0,
     "text": "Welcher Art sind die Beziehungen?"
    },
    {
     "id": "tg3-01-05",
     "level": 0,
     "text": "Wie sieht die Struktur aus?"
    },
    {
     "id": "tg3-01-06",
     "level": 0,
     "text": "Welche Annahmen liegen zugrunde?"
    }
   ]
  },
  {
