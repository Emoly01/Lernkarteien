  {
   "id": "tg3-08",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG3 · Die Denkschule der Ergebnisse",
   "status": "neu",
   "lines": [
    {
     "id": "tg3-08-01",
     "level": 0,
     "text": "Fokus"
    },
    {
     "id": "tg3-08-02",
     "level": 1,
     "text": "Energie; Gleichgewicht, Stabilität, Homöostase"
    },
    {
     "id": "tg3-08-03",
     "level": 1,
     "text": "Pflegeergebnis"
    },
    {
     "id": "tg3-08-04",
     "level": 0,
     "text": "Person"
    },
    {
     "id": "tg3-08-05",
     "level": 1,
     "text": "adaptives, entwicklungsbedingtes Wesen"
    },
    {
     "id": "tg3-08-06",
     "level": 0,
     "text": "Patient:in"
    },
    {
     "id": "tg3-08-07",
     "level": 1,
     "text": "Mangel an Anpassung, System-Defizienz"
    },
    {
     "id": "tg3-08-08",
     "level": 0,
     "text": "Orientierung"
    },
    {
     "id": "tg3-08-09",
     "level": 1,
     "text": "Krankheit, Leiden"
    },
    {
     "id": "tg3-08-10",
     "level": 0,
     "text": "Rolle der Pflegekraft"
    },
    {
     "id": "tg3-08-11",
     "level": 1,
     "text": "externer Regulationsmechanismus"
    },
    {
     "id": "tg3-08-12",
     "level": 0,
     "text": "Entscheidungsträger"
    },
    {
     "id": "tg3-08-13",
     "level": 1,
     "text": "Pflegekraft der gesundheitlichen Grundversorgung"
    }
   ]
  },
  {
   "id": "tg3-09",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG3 · Die Denkschulen im Vergleich: Patient:in und Pflegekraft",
   "status": "neu",
   "lines": [
    {
     "id": "tg3-09-01",
     "level": 0,
     "text": "Denkschule | Patient:in ist …"
    },
    {
     "id": "tg3-09-02",
     "level": 0,
     "text": "Bedürfnis | ?Bedürfnisdefizit"
    },
    {
     "id": "tg3-09-03",
     "level": 0,
     "text": "Interaktion | ?hilfloses Wesen, menschliche Erfahrung mit Sinn"
    },
    {
     "id": "tg3-09-04",
     "level": 0,
     "text": "Ergebnis | ?Mangel an Anpassung, System-Defizienz"
    },
    {
     "id": "tg3-09-05",
     "level": 0,
     "text": "Und die Rolle der Pflegekraft?"
    },
    {
     "id": "tg3-09-06",
     "level": 0,
     "text": "Denkschule | Pflegekraft ist …"
    },
    {
     "id": "tg3-09-07",
     "level": 0,
     "text": "Bedürfnis | ?erfüllt Bedürfnisse, noch von der Medizin abhängig"
    },
    {
     "id": "tg3-09-08",
     "level": 0,
     "text": "Interaktion | ?bewusster Prozess des Helfens, Selbst als therapeutischer Agent"
    },
    {
     "id": "tg3-09-09",
     "level": 0,
     "text": "Ergebnis | ?externer Regulationsmechanismus"
    },
    {
     "id": "tg3-09-10",
     "level": 0,
     "text": "Gemeinsam: Orientierung an Krankheit und Leiden"
    }
   ]
  },
