     "id": "tg3-v2-12-04",
     "level": 0,
     "text": "Andere fassen Pflege allgemeingültig und entwerfen Begriffs- und Klassifikationssysteme"
    },
    {
     "id": "tg3-v2-12-05",
     "level": 0,
     "text": "Nur im Kontext der US-amerikanischen Pflegewissenschaft verständlich"
    },
    {
     "id": "tg3-v2-12-06",
     "level": 0,
     "text": "Ausweg für Praxisprobleme: Theorien geringer und mittlerer Reichweite"
    }
   ]
  },
