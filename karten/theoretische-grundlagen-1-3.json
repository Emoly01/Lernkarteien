  {
   "id": "tg1-09",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG1 · Geschichte der Pflegetheorien",
   "status": "neu",
   "lines": [
    {
     "id": "tg1-09-01",
     "level": 0,
     "text": "Bis 1940er: Pflege stark von anderen Disziplinen geprägt"
    },
    {
     "id": "tg1-09-02",
     "level": 0,
     "text": "Späte 1940er/1950er: Sozial- und Geisteswissenschaften gewinnen an Bedeutung"
    },
    {
     "id": "tg1-09-03",
     "level": 0,
     "text": "1952: Peplau, „Interpersonelle Beziehungen in der Pflege\""
    },
    {
     "id": "tg1-09-04",
     "level": 0,
     "text": "1968: „Nursing Research\" – Artikelserie von Dickoff, James und Wiedenbach"
    },
    {
     "id": "tg1-09-05",
     "level": 0,
     "text": "Anfang 1970er: Was ist eigentlich eine Theorie?"
    },
    {
     "id": "tg1-09-06",
     "level": 0,
     "text": "1980er/1990er: vermehrt Theorien mittlerer und kleiner Reichweite"
    },
    {
     "id": "tg1-09-07",
     "level": 0,
     "text": "Ab 2000: große Anzahl an Theorien mittlerer Reichweite"
    }
   ]
  },
