  },
  {
   "id": "tg2-v2-14",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG2 · Welche Prozesse der Theorieentwicklung gibt es? (Chinn & Kramer)",
   "status": "neu",
   "lines": [
    {
     "id": "tg2-v2-14-01",
     "level": 0,
     "text": "Konzeptuelle Bedeutung schaffen → Theorie strukturieren und kontextualisieren → Theoretische Beziehungen generieren und überprüfen → Theorie gezielt anwenden → Konzeptuelle Bedeutung schaffen"
    },
    {
     "id": "tg2-v2-14-02",
     "level": 0,
     "text": "Ein Kreislauf: Anwendung führt wieder zu neuer Bedeutung"
    }
   ]
  },
