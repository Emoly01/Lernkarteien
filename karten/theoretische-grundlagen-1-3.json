  {
   "id": "tg3-v2-01",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG3 · Aus welchen Komponenten besteht eine Theorie? (Chinn & Kramer)",
   "status": "neu",
   "lines": [
    {
     "id": "tg3-v2-01-01",
     "level": 0,
     "text": "Wozu?"
    },
    {
     "id": "tg3-v2-01-02",
     "level": 1,
     "text": "Was ist der Zweck der Theorie?"
    },
    {
     "id": "tg3-v2-01-03",
     "level": 0,
     "text": "Woraus?"
    },
    {
     "id": "tg3-v2-01-04",
     "level": 1,
     "text": "Welche Konzepte hat sie?"
    },
    {
     "id": "tg3-v2-01-05",
     "level": 1,
     "text": "Wie sind die Konzepte definiert?"
    },
    {
     "id": "tg3-v2-01-06",
     "level": 0,
     "text": "Wie verknüpft?"
    },
    {
     "id": "tg3-v2-01-07",
     "level": 1,
     "text": "Welcher Art sind die Beziehungen?"
    },
    {
     "id": "tg3-v2-01-08",
     "level": 1,
     "text": "Wie sieht die Struktur aus?"
    },
    {
     "id": "tg3-v2-01-09",
     "level": 0,
     "text": "Worauf gebaut?"
    },
    {
     "id": "tg3-v2-01-10",
     "level": 1,
     "text": "Welche Annahmen liegen zugrunde?"
    },
    {
     "id": "tg3-v2-01-11",
     "level": 0,
     "text": "Komponenten beschreiben eine Theorie – die Reflexionsfragen (TG3) bewerten sie"
    }
   ]
  },
  {
