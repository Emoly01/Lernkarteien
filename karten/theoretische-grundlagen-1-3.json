  {
   "id": "tg2-v2-08",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG2 · Wie nah an der Realität sind Theorien? (Hunink, 4 Stufen)",
   "status": "neu",
   "lines": [
    {
     "id": "tg2-v2-08-01",
     "level": 0,
     "text": "Nach ihrer Beziehung zur Realität, von außen nach innen"
    },
    {
     "id": "tg2-v2-08-02",
     "level": 1,
     "text": "beschreibend → erklärend → voraussagend → vorschreibend"
    },
    {
     "id": "tg2-v2-08-03",
     "level": 0,
     "text": "Fachbegriffe"
    },
