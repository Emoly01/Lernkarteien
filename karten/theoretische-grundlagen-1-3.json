 "cards": [
  {
   "id": "tg1-v2-01",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG1 · Welche Grundbegriffe unterscheidet Meleis?",
   "status": "neu",
   "lines": [
    {
     "id": "tg1-v2-01-01",
     "level": 0,
     "text": "Merkhilfe: „Wer Pflege denkt, prüft Annahmen\""
    },
    {
     "id": "tg1-v2-01-02",
     "level": 0,
     "text": "Die fünf Grundbegriffe"
    },
    {
     "id": "tg1-v2-01-03",
     "level": 1,
     "text": "Anfangs­buch­stabe | Grundbe­griff"
    },
    {
     "id": "tg1-v2-01-04",
     "level": 1,
     "text": "W | ?Wis­sen­schaft"
    },
    {
     "id": "tg1-v2-01-05",
     "level": 1,
     "text": "P | ?Paradigma"
    },
    {
     "id": "tg1-v2-01-06",
     "level": 1,
     "text": "D | ?Domäne"
    },
    {
     "id": "tg1-v2-01-07",
     "level": 1,
     "text": "P | ?Phänomen"
    },
    {
     "id": "tg1-v2-01-08",
     "level": 1,
     "text": "A | ?Annahmen"
    },
    {
     "id": "tg1-v2-01-09",
     "level": 0,
     "text": "Dazu: Konzept bzw. Begriff, Modell, Theorie – greifen ineinander wie Zahnräder"
    }
   ]
  },
  {
   "id": "tg1-v2-02",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG1 · Was ist ein Konzept?",
   "status": "neu",
   "lines": [
    {
     "id": "tg1-v2-02-01",
     "level": 0,
     "text": "Konzept (dt.) = Idee oder Plan; concept (engl.) = Begriff"
    },
    {
     "id": "tg1-v2-02-02",
     "level": 0,
     "text": "Beschreibt ein Phänomen oder eine Gruppe von Phänomenen"
    },
    {
     "id": "tg1-v2-02-03",
     "level": 0,
     "text": "Abstrakte Verallgemeinerung beobachteter Sachverhalte"
    },
    {
     "id": "tg1-v2-02-04",
     "level": 0,
     "text": "Annahmen verbinden Konzepte miteinander"
    },
    {
     "id": "tg1-v2-02-05",
     "level": 0,
     "text": "Kleinster Baustein einer Theorie"
    }
   ]
  },
  {
   "id": "tg1-v2-03",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG1 · Was ist ein Modell?",
   "status": "neu",
   "lines": [
    {
     "id": "tg1-v2-03-01",
     "level": 0,
     "text": "Vereinfachte und modifizierte Darstellung eines tatsächlichen Sachverhalts"
    },
    {
     "id": "tg1-v2-03-02",
     "level": 0,
     "text": "Zwei Arten"
    },
    {
     "id": "tg1-v2-03-03",
     "level": 1,
     "text": "gegenständliche bzw. empirische Modelle (z. B. Herzmodell)"
    },
    {
     "id": "tg1-v2-03-04",
     "level": 1,
     "text": "abstrakte bzw. theoretische Modelle (z. B. Organigramm)"
    },
    {
     "id": "tg1-v2-03-05",
     "level": 0,
     "text": "Merkmale (Neumann-Ponesch, 2021)"
    },
    {
     "id": "tg1-v2-03-06",
     "level": 1,
     "text": "Reduktion der Realität"
    },
    {
     "id": "tg1-v2-03-07",
     "level": 1,
     "text": "Hervorhebung von Perspektiven des sozialen Umfelds"
    },
    {
     "id": "tg1-v2-03-08",
     "level": 1,
     "text": "Schaffung von Übersichtlichkeit"
    },
    {
     "id": "tg1-v2-03-09",
     "level": 0,
     "text": "Modell oder Theorie? Begriffe werden teils synonym verwendet, Abgrenzung oft schwierig"
    }
   ]
  },
  {
   "id": "tg1-v2-04",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG1 · Was sollen Pflegemodelle leisten?",
   "status": "neu",
   "lines": [
    {
     "id": "tg1-v2-04-01",
     "level": 0,
     "text": "Abstrakte Modelle von dem, was Pflege ist oder sein sollte"
    },
    {
     "id": "tg1-v2-04-02",
     "level": 0,
     "text": "Systematisch aufgebaut"
    },
    {
     "id": "tg1-v2-04-03",
     "level": 0,
     "text": "Wissenschaftliche Grundlage"
    },
    {
     "id": "tg1-v2-04-04",
     "level": 0,
     "text": "Logisch verknüpfte Bestandteile"
    },
    {
     "id": "tg1-v2-04-05",
     "level": 0,
     "text": "Auf Verwendbarkeit und Gültigkeit in der Praxis überprüft"
    }
   ]
  },
  {
   "id": "tg1-v2-05",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG1 · Was ist eine Theorie nach Meleis?",
   "status": "neu",
   "lines": [
    {
     "id": "tg1-v2-05-01",
     "level": 0,
     "text": "Bündel von Ideen oder erklärenden Vermutungen, für einen speziellen Zweck konstruiert"
    },
    {
     "id": "tg1-v2-05-02",
     "level": 0,
     "text": "Systematische Abstraktion"
    },
    {
     "id": "tg1-v2-05-03",
     "level": 1,
     "text": "strukturiert die zugrunde liegenden Phänomene"
    },
    {
     "id": "tg1-v2-05-04",
     "level": 1,
     "text": "ist nicht mit der Wirklichkeit identisch"
    },
    {
     "id": "tg1-v2-05-05",
     "level": 0,
     "text": "Besteht aus Konzepten"
    },
    {
     "id": "tg1-v2-05-06",
     "level": 0,
     "text": "Zweck: Beschreibung, Erklärung, Vorhersage"
    },
    {
     "id": "tg1-v2-05-07",
     "level": 0,
     "text": "Pflegetheorie = Konzeptualisierung einiger Aspekte der Pflegerealität"
    }
   ]
  },
  {
   "id": "tg1-v2-06",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG1 · Theorienmonismus oder Theorienpluralismus?",
   "status": "neu",
   "lines": [
    {
     "id": "tg1-v2-06-01",
     "level": 0,
     "text": "Theorienmonismus"
    },
    {
     "id": "tg1-v2-06-02",
     "level": 1,
     "text": "eine umfassende, allgemeingültige Theorie der Pflege"
    },
    {
     "id": "tg1-v2-06-03",
     "level": 0,
     "text": "Theorienpluralismus"
    },
    {
     "id": "tg1-v2-06-04",
     "level": 1,
     "text": "verschiedene, widerstreitende und teils überlappende Theorien sind gleichzeitig einflussreich"
    },
    {
     "id": "tg1-v2-06-05",
     "level": 0,
     "text": "Evers (1991): Pflege ist so komplex, dass Pluralismus notwendig ist"
    },
    {
     "id": "tg1-v2-06-06",
     "level": 1,
     "text": "die alles erklärende Pflegetheorie ist eine Illusion"
    },
    {
     "id": "tg1-v2-06-07",
     "level": 0,
     "text": "Merkhilfe: mono = eine für alles, plural = viele nebeneinander"
    }
   ]
  },
  {
   "id": "tg1-v2-07",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG1 · Warum braucht die Pflege Theorien? (Chinn & Kramer)",
   "status": "neu",
   "lines": [
    {
     "id": "tg1-v2-07-01",
     "level": 0,
     "text": "Fundierte Grundlage für die Praxis"
    },
    {
     "id": "tg1-v2-07-02",
     "level": 0,
     "text": "Stiften professionelle Identität"
    },
    {
     "id": "tg1-v2-07-03",
     "level": 0,
     "text": "Räumen Meinungsverschiedenheiten aus, was in der Pflege machbar ist"
    },
    {
     "id": "tg1-v2-07-04",
     "level": 0,
     "text": "Grundlage für bewusste Entscheidungen"
    },
    {
     "id": "tg1-v2-07-05",
     "level": 0,
     "text": "„Kolumbus ist nicht ziellos umhergereist. Er segelte nach Westen aufgrund einer plausiblen Theorie.\""
    }
   ]
  },
  {
   "id": "tg1-v2-08",
   "subject": "Theoretische Grundlagen der Pflege",
   "title": "TG1 · Welche 7 Funktionen haben Theorien nach Hunink?",
   "status": "neu",
   "lines": [
    {
     "id": "tg1-v2-08-01",
     "level": 0,
     "text": "Ordnen"
    },
    {
     "id": "tg1-v2-08-02",
     "level": 1,
     "text": "Bezugsrahmen"
    },
    {
     "id": "tg1-v2-08-03",
     "level": 1,
     "text": "Ordnung von Phänomenen"
    },
    {
     "id": "tg1-v2-08-04",
     "level": 0,
     "text": "Handeln"
    },
    {
     "id": "tg1-v2-08-05",
     "level": 1,
     "text": "Ratgeber für die praktische Situation"
    },
    {
     "id": "tg1-v2-08-06",
     "level": 1,
     "text": "Grundlage pflegerischer Ethik"
    },
    {
     "id": "tg1-v2-08-07",
     "level": 1,
     "text": "Grundlage pflegerischer Qualitätssicherung"
    },
    {
     "id": "tg1-v2-08-08",
     "level": 0,
     "text": "Lehren und Forschen"
    },
    {
     "id": "tg1-v2-08-09",
     "level": 1,
     "text": "Grundlage der Aus- und Weiterbildung"
    },
    {
     "id": "tg1-v2-08-10",
     "level": 1,
     "text": "Rahmen für Pflegeforschung"
    },
    {
     "id": "tg1-v2-08-11",
     "level": 0,
     "text": "Merkhilfe: die drei Gruppen (ordnen, handeln, lehren & forschen) sind nur eine Eselsbrücke, nicht von Hunink"
    },
    {
     "id": "tg1-v2-08-12",
     "level": 0,
     "text": "Nicht verwechseln mit Huninks 4 Stufen nach Realitätsbezug (beschreibend bis vorschreibend, TG2)"
    }
   ]
  },
