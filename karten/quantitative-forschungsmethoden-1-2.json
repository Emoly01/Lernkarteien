  {
   "id": "qf1-02",
   "subject": "Quantitative Forschungsmethoden",
   "title": "QF1 · Zeit, Teilnehmer, Hilfsmittel – worauf achten?",
   "status": "neu",
   "lines": [
    {
     "id": "qf1-02-01",
     "level": 0,
     "text": "Zeit"
    },
    {
     "id": "qf1-02-02",
     "level": 1,
     "text": "realistischer Zeitrahmen für das Forschungsproblem"
    },
    {
     "id": "qf1-02-03",
     "level": 1,
     "text": "fester Abschlusstermin als Grundlage der Planung"
    },
    {
     "id": "qf1-02-04",
     "level": 1,
     "text": "zeitlicher Puffer für Unvorhergesehenes"
    },
    {
     "id": "qf1-02-05",
     "level": 0,
     "text": "Studienteilnehmer"
    },
    {
     "id": "qf1-02-06",
     "level": 1,
     "text": "ausreichende Anzahl geeigneter Teilnehmer, auch nach unerwartetem Verlust"
    },
    {
     "id": "qf1-02-07",
     "level": 0,
     "text": "Hilfsmittel"
    },
    {
     "id": "qf1-02-08",
     "level": 1,
     "text": "Raum, Computer, Software (Statistikprogramm)"
    },
    {
     "id": "qf1-02-09",
     "level": 1,
     "text": "Internetzugang, Bibliothek für Fachliteratur"
    },
    {
     "id": "qf1-02-10",
     "level": 1,
     "text": "Telefon, Papier, Briefmarken usw."
    }
   ]
  },
  {
