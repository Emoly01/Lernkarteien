    },
    {
     "id": "qf1-03-04",
     "level": 0,
     "text": "Erfahrene Forscher"
    },
    {
     "id": "qf1-03-05",
     "level": 1,
     "text": "Sachkenntnis zur Forschungsfrage"
    },
    {
     "id": "qf1-03-06",
